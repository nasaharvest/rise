# =============================================================================
# Project-specific
# =============================================================================

# Run-book 57 results (spec 24 _result.json files) — never committed
_runbook57/

# Data files — ignored everywhere...
*.csv
*.xlsx
*.xls
data/
cache/

# ...except synthetic practice datasets under rdm/data/sample_data/
# (not real provider data, safe to share). Git can't re-include a file whose
# parent directory is ignored, so each level is un-ignored explicitly and its
# other contents re-ignored. Must stay BELOW the data rules above.
!rdm/data/
rdm/data/*
!rdm/data/sample_data/
!rdm/data/sample_data/**

# Notebooks — ignored, except for the files below
notebooks/*
!notebooks/shapefiles/
!notebooks/build_images.ipynb
!notebooks/e2e_austria_aml.ipynb
!notebooks/e2e_austria_aml_s1.ipynb
!notebooks/demo_model/
notebooks/demo_model/*
!notebooks/demo_model/my_adapter.py
!notebooks/demo_model/my_adapter_s1.py